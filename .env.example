# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection (create the database first: createdb listener)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/listener

# Telegram (from @BotFather and getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which search API to use: serper | serpapi | brave
SEARCH_PROVIDER=serper
SERPER_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=

# Two-letter country code to bias results toward (ng = Nigeria)
SEARCH_COUNTRY=ng

# How far back each search looks: day | week | month
# "week" is a good default: it tolerates search-engine indexing delay,
# and duplicates are ignored anyway.
LOOKBACK=week

# Where to look: web, facebook, x (comma separated)
# facebook = site:facebook.com search, x = site:x.com search.
# Each keyword is searched once per channel, so cost = keywords x channels x cycles.
CHANNELS=web,facebook

# How often to run a full cycle, in minutes (180 = every 3 hours)
POLL_INTERVAL_MINUTES=180

# Max Telegram alerts sent per cycle. Extras wait for the next cycle,
# newest first, so the first run cannot flood your phone.
MAX_ALERTS_PER_CYCLE=10

# Results requested per search (10 is the cheapest on most providers)
RESULTS_PER_QUERY=10

# Optional: comma-separated words. Results containing any of them are silenced.
# Example: EXCLUDE_TERMS=vacancy,hiring,job opening
EXCLUDE_TERMS=
